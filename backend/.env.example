# --- OpenRouter (https://openrouter.ai/keys) — free models end in ":free" ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Supabase (Project settings -> API). Leave empty for local mode (no login, in-memory usage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS: the React frontend's URL (comma-separate several) ---
FRONTEND_URL=http://localhost:3000
# Optional: lock CORS to your published Chrome extension ID
EXTENSION_ID=
