# --- OpenRouter (https://openrouter.ai/keys) — free models end in ":free" ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODELS=google/gemma-3-27b-it:free,mistralai/mistral-small-3.2-24b-instruct:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Supabase (Project settings -> API). Leave empty for local mode (no login, in-memory usage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS: the React frontend's URL (comma-separate several) ---
FRONTEND_URL=http://localhost:3000
# Optional: lock CORS to your published Chrome extension ID
EXTENSION_ID=
