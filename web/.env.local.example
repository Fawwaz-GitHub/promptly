# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Primary model. Any model ending in ":free" costs nothing.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional comma-separated fallbacks tried by OpenRouter if the primary is busy
OPENROUTER_FALLBACK_MODELS=google/gemma-3-27b-it:free,mistralai/mistral-small-3.2-24b-instruct:free

# --- Supabase (https://supabase.com -> Project settings -> API) ---
# Leave these empty to run in "local mode": no login, usage kept in memory.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Chrome extension ID (chrome://extensions after "Load unpacked"); lets the site hand the login to the extension
NEXT_PUBLIC_EXTENSION_ID=
# Optional: point at a different OpenAI-compatible endpoint (used for local testing)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
